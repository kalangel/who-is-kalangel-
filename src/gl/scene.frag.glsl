#version 300 es
precision highp float;

/* ============================================================================
   kalangel — «Затмение». Вся сцена: один фрагментный шейдер.

   Сквозная идея: тело, которое закрывает светило в первом акте, — это чёрная
   дыра. Кольцо затмения и есть кольцо Эйнштейна. Сайт не отвечает, кто такой
   kalangel, потому что ответ за горизонтом событий. В финале та же дыра
   съедает созвездие с ником и остаётся единственной дверью — в канал.

   Фотоны трассируются по геодезическим Шварцшильда (rs = 1, горизонт r = 1,
   фотонная сфера 1.5, ISCO 3). Кольцо, тень, изгиб фона, допплеровский перекос
   диска — не нарисованы, а посчитаны.

   Восемь актов на одном числе uPhase:
     0.00–0.13  затмение: тень, кольцо Эйнштейна, корона
     0.10–0.26  раскрытие: камера поднимается, диск загорается
     0.22–0.44  чёрная дыра целиком: тень, фотонное кольцо, лензированный диск
     0.42–0.53  падение к горизонту → вспышка → белое
     0.51–0.66  белое оказалось поверхностью гиганта: гранулы, протуберанцы
     0.64–0.86  отъезд: звезда сжимается в точку, небо густеет до тысяч звёзд
     0.84–0.93  самые яркие звёзды складываются в марку и ник
     0.90–1.00  дыра возвращается, выпивает созвездие, горизонт остаётся дверью
   ============================================================================ */

out vec4 fragColor;
in vec2 vUv;

uniform vec2  uRes;
uniform float uTime;
uniform float uPhase;
uniform vec2  uPointer;      // −1..1, паралакс от указателя/наклона
uniform sampler2D uMark;     // маска вордмарка: r = светимость
uniform float uMarkAspect;   // ширина/высота вордмарка

#ifndef STEPS
#define STEPS 128
#endif

/* ---------------------------------------------------------------- палитра --
   Железное правило: ни одного холодного пикселя. Исключение ровно одно —
   точки звёзд, у них настоящие спектральные классы.                        */

const vec3 BG   = vec3(0.020, 0.012, 0.008);
const vec3 CORE = vec3(1.000, 0.957, 0.886);
const vec3 HOT  = vec3(1.000, 0.541, 0.122);
const vec3 DEEP = vec3(0.761, 0.255, 0.047);
const vec3 FADE = vec3(0.165, 0.059, 0.016);

const float RIN  = 3.0;      // ISCO: ближе диск не держится
const float ROUT = 17.0;

const float PI = 3.14159265;

/* ------------------------------------------------------------- утилиты ---- */

float S(float a, float b, float x) { return smoothstep(a, b, x); }

/** Колокол 0→1→0 внутри окна: для одноразовых событий вроде вспышки. */
float bump(float a, float b, float x) {
  float t = clamp((x - a) / max(b - a, 1e-4), 0.0, 1.0);
  return sin(t * PI);
}

mat2 rot(float a) { float c = cos(a), s = sin(a); return mat2(c, -s, s, c); }

float hash11(float p) {
  p = fract(p * 0.1031);
  p *= p + 33.33;
  return fract(p * (p + p));
}

vec4 hash42(vec2 p) {
  vec4 p4 = fract(vec4(p.xyxy) * vec4(0.1031, 0.1030, 0.0973, 0.1099));
  p4 += dot(p4, p4.wzxy + 33.33);
  return fract((p4.xxyz + p4.yzzw) * p4.zywx);
}

float hash13(vec3 p) {
  p = fract(p * 0.1031);
  p += dot(p, p.zyx + 31.32);
  return fract((p.x + p.y) * p.z);
}

float vnoise(vec3 p) {
  vec3 i = floor(p), f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float n = mix(
    mix(mix(hash13(i + vec3(0, 0, 0)), hash13(i + vec3(1, 0, 0)), f.x),
        mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y),
    mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),
        mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y),
    f.z);
  return n;
}

float fbm(vec3 p, int oct) {
  float a = 0.5, s = 0.0, n = 0.0;
  for (int i = 0; i < 6; i++) {
    if (i >= oct) break;
    s += a * vnoise(p);
    n += a;
    p *= 2.03;
    p.xy *= rot(0.7);
    a *= 0.5;
  }
  return s / max(n, 1e-4);
}

/** Клеточный шум: F2−F1 даёт тёмные перемычки между ячейками. Именно этим
 *  поверхность звезды отличается от размытого шума — у неё есть границы. */
vec3 cellF(vec2 p) {
  vec2 i = floor(p), f = fract(p);
  float f1 = 8.0, f2 = 8.0, id = 0.0;
  for (int y = -1; y <= 1; y++) {
    for (int x = -1; x <= 1; x++) {
      vec2 o = vec2(float(x), float(y));
      vec4 h = hash42(i + o);
      vec2 c = o + h.xy;
      float d = length(f - c);
      // Номер ближайшей ячейки возвращается третьим числом: без него все
      // гранулы одной температуры и поверхность читается сотами, а не
      // кипящим веществом.
      if (d < f1) { f2 = f1; f1 = d; id = h.z; } else if (d < f2) { f2 = d; }
    }
  }
  return vec3(f1, f2, id);
}

/** Тёплая температурная лестница. Заменяет физический планковский спектр:
 *  синий конец нам запрещён палитрой, а на диске он и так съеден красным
 *  смещением. Идёт от углей через оранжевый к почти белому ядру. */
vec3 heat(float t) {
  t = clamp(t, 0.0, 1.0);
  vec3 c = mix(vec3(0.06, 0.012, 0.004), FADE, S(0.0, 0.18, t));
  c = mix(c, DEEP, S(0.12, 0.42, t));
  c = mix(c, HOT,  S(0.38, 0.72, t));
  c = mix(c, CORE, S(0.66, 0.94, t));
  c = mix(c, vec3(1.0, 0.99, 0.98), S(0.9, 1.0, t));
  return c;
}

/** Спектральные классы. Единственное холодное место на сайте — и то точками:
 *  голубые сверхгиганты ломают жёлтую монотонность неба. */
vec3 starColor(float h) {
  vec3 c = mix(vec3(0.55, 0.66, 1.00), vec3(0.86, 0.90, 1.00), S(0.00, 0.16, h));
  c = mix(c, vec3(1.00, 1.00, 0.99), S(0.14, 0.34, h));
  c = mix(c, vec3(1.00, 0.93, 0.74), S(0.32, 0.60, h));
  c = mix(c, vec3(1.00, 0.72, 0.42), S(0.56, 0.82, h));
  c = mix(c, vec3(1.00, 0.49, 0.30), S(0.80, 1.00, h));
  return c;
}

/* ------------------------------------------------------------------ небо --
   Небо задано на сфере, а не на плоскости: иначе лензированный луч, который
   уходит вбок или назад, некуда девать. Проекция — на грани куба, у неё нет
   ни полюсов, ни шва по долготе.                                           */

void cubeProject(vec3 d, out vec2 p, out float face) {
  vec3 a = abs(d);
  if (a.z >= a.x && a.z >= a.y) {
    p = d.xy / max(a.z, 1e-5);
    face = d.z < 0.0 ? 0.0 : 1.0;   // грань 0 — «вперёд», на ней живёт марка
  } else if (a.x >= a.y) {
    p = d.zy / max(a.x, 1e-5);
    face = d.x < 0.0 ? 2.0 : 3.0;
  } else {
    p = d.xz / max(a.y, 1e-5);
    face = d.y < 0.0 ? 4.0 : 5.0;
  }
}

uniform float uMarkHalf;   // полуширина марки в координатах передней грани
uniform float uMarkAmt;    // 0 — марки нет, 1 — созвездие собрано

/** Шаг клеток слоя созвездия. Приходит снаружи: он считается от высоты окна,
 *  чтобы клетка всегда была около семи экранных пикселей. Константа здесь
 *  означала бы, что на телефоне созвездие или сливается в пятно, или
 *  рассыпается на десяток точек. */
uniform float uMarkDensity;

float markAt(vec2 p) {
  vec2 t = p / vec2(uMarkHalf, uMarkHalf / uMarkAspect);
  if (abs(t.x) > 1.0 || abs(t.y) > 1.0) return 0.0;
  vec2 uv = t * 0.5 + 0.5;
  return texture(uMark, vec2(uv.x, 1.0 - uv.y)).r;
}

/** Четырёхлучевая дифракция: вертикальные лучи длинные, горизонтальные
 *  короткие. Та же геометрия, что у звезды в логотипе, — небо и марка
 *  сделаны из одного элемента. */
float spikes(vec2 q, float len) {
  vec2 a = abs(q);
  // Затухание экспоненциальное, и хвост у него длинный: множитель на длину
  // здесь стоит скромный не по робости, а потому что при большом луч тянется
  // через полэкрана и небо превращается в дождь.
  float v = exp(-a.y / (len * 0.85)) * exp(-a.x * 2.6);
  float h = exp(-a.x / (len * 0.34)) * exp(-a.y * 3.2);
  return v + h * 0.7;
}

uniform float uSkyDensity;
uniform float uSkyGain;

vec3 starLayer(vec3 dir, float density, float amp, float seed, float markAmt) {
  vec2 p; float face;
  cubeProject(dir, p, face);

  vec2 sp = p * density + face * 137.0;
  vec2 id = floor(sp);
  vec2 fp = fract(sp);
  // Размер пикселя в клеточных единицах: звёзды рисуются в экранных пикселях,
  // поэтому остаются точками на любом зуме и не превращаются в кляксы.
  float px = max(length(fwidth(sp)), 1e-5);

  // Мип. Когда клетка мельче пикселя, отдельную звезду не разрешить: каждая
  // клетка оказывается «в центре» и слой заливает экран ровным молоком.
  // Такой слой обязан гаснуть, а не светиться. Это же снимает пунктир из
  // размазанных звёзд у самой линзы, где производная взрывается.
  float mip = 1.0 - smoothstep(0.16, 0.5, px);
  if (mip < 0.002) return vec3(0.0);

  vec3 acc = vec3(0.0);
  for (int y = -1; y <= 1; y++) {
    for (int x = -1; x <= 1; x++) {
      vec2 o = vec2(float(x), float(y));
      vec4 h = hash42(id + o + seed);
      if (h.w > 0.72) continue;              // не в каждой клетке звезда

      // Разброс почти на всю клетку. При скромном джиттере сетка клеток
      // читается глазом как решётка — небо сразу превращается в текстуру.
      vec2 sPos = o + 0.06 + h.xy * 0.88;
      vec2 dv = (fp - sPos) / px;
      float dp = length(dv);
      if (dp > 90.0) continue;

      // Величина: степень делает большинство звёзд слабыми, а несколько —
      // яркими. Равномерное распределение читается манной крупой.
      float mag = pow(h.z, 5.0);

      float mk = 0.0;
      if (face < 0.5 && markAmt > 0.001) {
        mk = markAt((id + sPos - face * 137.0) / density) * markAmt;
      }
      // В марке звезда не дорисовывается, а повышается в классе: рисунок
      // складывается из тех же звёзд, что и всё небо. Порог по h.w оставляет
      // в марке не все клетки — созвездие должно быть россыпью, а не заливкой.
      // В марку идёт треть уцелевших клеток. Если брать все, рисунок
      // заливается сплошным светом и перестаёт быть созвездием.
      float pick = step(h.w, 0.24);
      mag = mix(mag, max(mag, 0.7 + 0.3 * h.z), mk * pick);

      float tw = 0.78 + 0.22 * sin(uTime * (0.7 + h.x * 2.6) + h.y * 41.0);
      float b = amp * (0.02 + mag * 1.6) * tw * (1.0 + mk * 3.0);

      float core = exp(-dp * dp * 0.62);
      float halo = 0.35 / (1.0 + dp * dp * 1.8);
      // Класс берётся из отдельного числа, а не из яркости. Связать их — значит
      // покрасить все крупные звёзды в один конец спектра: небо станет ржавым.
      vec3 col = starColor(fract(h.x * 7.31 + h.y * 3.17));

      acc += col * (core + halo * 0.5) * b;
      if (mag > 0.42) {
        acc += col * spikes(dv, 1.4 + mag * 6.0) * b * (0.3 + mk * 1.1);
      }
    }
  }
  return acc * mip;
}

/** Пыль и рукав галактики. Ровный чёрный фон читается как пустой холст —
 *  небу нужна структура, но настолько слабая, чтобы её не замечали. */
vec3 dust(vec3 d) {
  float band = exp(-pow(abs(d.y * 2.4 + fbm(d * 1.7, 2) * 0.5 - 0.25), 2.0) * 5.0);
  float n = fbm(d * 3.1, 3);
  float m = fbm(d * 8.0, 2);
  vec3 c = mix(FADE * 0.7, DEEP * 0.5, n);
  return c * band * (0.20 + 0.55 * n) * (0.4 + 0.8 * m) * 0.20;
}

vec3 sky(vec3 d) {
  float D = uSkyDensity;
  vec3 c = dust(d);
  c += starLayer(d, D * 1.00, 1.00, 11.0, 0.0);
  c += starLayer(d, D * 2.30, 0.66, 57.0, 0.0);
  // Дальние слои включаются только на отъезде: вблизи дыры они не видны,
  // а стоят столько же. Условие одинаково для всего кадра — ветвление
  // бесплатное.
  if (D > 1.9) c += starLayer(d, D * 5.10, 0.40, 91.0, 0.0);
  if (D > 2.8) c += starLayer(d, D * 10.4, 0.24, 23.0, 0.0);

  // У созвездия свой слой с фиксированным шагом. Привязать рисунок к общей
  // плотности неба нельзя: на крупных слоях шаг клетки — сотни пикселей, и
  // на весь логотип приходится пяток звёзд. Шаг здесь выбран так, чтобы на
  // марку легли сотни клеток, — только тогда из точек читается начертание.
  if (uMarkAmt > 0.001) c += starLayer(d, uMarkDensity, 0.62, 313.0, uMarkAmt);
  return c * uSkyGain;
}

/* --------------------------------------------------------- фоновое светило --
   Источник ровно за дырой. Луч, обогнувший тень, приносит его свет обратно в
   кадр — так получается кольцо. Оно не нарисовано: это тот же источник,
   размазанный гравитацией по окружности.                                    */

uniform vec3  uLightDir;
uniform float uGlow;

vec3 backGlow(vec3 d) {
  if (uGlow < 0.001) return vec3(0.0);

  float c = dot(d, uLightDir);
  float a = max(1.0 - c, 0.0);   // ≈ θ²/2

  // Само светило — почти точка. Это принципиально: широкий источник
  // размазывается в ровный бублик, а точечный даёт тонкое кольцо Эйнштейна,
  // ради которого всё и затевалось.
  float disc = exp(-a * 90000.0);
  float ring = exp(-a * 700.0);

  // Корона протяжённая, поэтому её свет ложится ЗА кольцом, снаружи тени.
  // Лучи, а не ровное гало: азимутальный шум вокруг оси на светило.
  vec3 t = normalize(cross(uLightDir, vec3(0.0, 1.0, 0.0)) + vec3(1e-4));
  vec3 b = cross(uLightDir, t);
  float az = atan(dot(d, b), dot(d, t));
  float str = fbm(vec3(cos(az) * 2.4, sin(az) * 2.4, uTime * 0.03), 4);
  float cor = exp(-sqrt(a) * 5.2) * (0.28 + 1.5 * pow(str, 1.7));

  vec3 v = CORE * disc * 22.0
         + CORE * ring * 0.5
         + mix(HOT, DEEP, 0.35) * cor * 0.13;
  return v * uGlow;
}

/* -------------------------------------------------------- аккреционный диск */

uniform float uDisk;

vec3 diskColor(vec3 hit, vec3 vel) {
  float r = length(hit.xz);

  // Кеплеровский сдвиг: внутренние кольца обгоняют внешние. Поворачиваем
  // точку выборки на угол вращения — шума на шве atan при этом не возникает.
  float w = uTime * 1.15 * pow(r, -1.5) * 4.0;
  vec2 sp = rot(-w) * hit.xz;

  // Крупная структура вращается как целое, мелкая — со сдвигом. Если сдвиг
  // отдать всему сразу, за минуту наблюдения диск наматывается в бесконечную
  // граммофонную пластинку: концентрические кольца и ни одного пятна.
  float nBig = fbm(vec3(rot(-uTime * 0.22) * hit.xz * 0.20, 1.7), 4);
  float nFine = fbm(vec3(sp * 0.85, r * 0.35), 4);
  // Волокна, а не вата: степень выедает середину и оставляет жгуты.
  float fil = pow(clamp(nBig * 1.45, 0.0, 1.0), 1.7) * (0.30 + 1.1 * nFine);

  // Температура по радиусу: T ~ r^(-3/4).
  float T = pow(RIN / r, 0.75);
  vec3 c = heat(T * 0.98);

  // Плотность: внутренняя кромка обрывается на ISCO, внешняя растворяется.
  float env = S(RIN, RIN * 1.16, r) * (1.0 - S(ROUT * 0.55, ROUT, r));
  float dens = env * (0.30 + 1.5 * fil);

  // Допплер. Половина диска, идущая на зрителя, светит в разы сильнее — это
  // и есть тот самый перекос, по которому дыру узнают.
  vec3 orb = normalize(cross(vec3(0.0, 1.0, 0.0), hit));
  float beta = 0.52 * sqrt(RIN / r);
  float g = 1.0 / max(1.0 - beta * dot(orb, -normalize(vel)), 0.16);
  // Потолок нужен: без него приближающийся край уходит в единственное белое
  // пятно и съедает всю структуру диска, ради которой всё и считалось.
  float dop = min(pow(g, 3.2), 9.0);

  // Гравитационное красное смещение: у горизонта свет вязнет.
  float grav = sqrt(max(1.0 - 1.0 / r, 0.02));

  float bright = pow(RIN / r, 1.9) * 0.30;
  return c * dens * bright * dop * grav * uDisk;
}

/* ------------------------------------------------------- геодезики фотонов --
   Уравнение орбиты фотона в метрике Шварцшильда, записанное как ускорение
   в декартовых координатах: a = −3/2 · h² · r⃗ / r⁵ при rs = 1.
   Горизонт — r = 1, фотонная сфера — 1.5.                                   */

uniform float uSwirl;   // финал: закрутка фона по мере втягивания
uniform float uLimb;    // свечение у фотонной сферы: кольцо затмения

vec3 raymarch(vec3 ro, vec3 rd, out float captured) {
  vec3 pos = ro;
  vec3 vel = rd;
  float h2 = dot(cross(pos, vel), cross(pos, vel));

  vec3 col = vec3(0.0);
  vec3 limbCol = vec3(0.0);
  captured = 1.0;
  // Луч, ушедший дальше старта и продолжающий удаляться, назад уже не вернётся.
  float far = length(ro) + 8.0;

  for (int i = 0; i < STEPS; i++) {
    float r2 = dot(pos, pos);
    float r = sqrt(r2);

    if (r < 1.0) break;
    // Обрыв по шагам — не «луч ушёл». Тот, кто за весь бюджет так и не
    // выбрался, наматывает витки у фотонной сферы: он пойман. Считать его
    // ушедшим — значит вывесить вокруг тени венок ложных колец из фона.
    if (r > far && dot(pos, vel) > 0.0) { captured = 0.0; break; }

    // Шаг двухрежимный. Вдали траектория почти прямая, и подробничать там —
    // значит потратить весь бюджет на пустой перелёт: на телефоне с его
    // восемью десятками шагов луч тогда не долетает до дыры, обрывается по
    // счётчику, считается пойманным, и кадр становится сплошь чёрным.
    // Вблизи наоборот: крупный шаг накапливает ошибку, лучи с околокритическим
    // прицелом валятся внутрь, и тень раздувается против теоретической.
    float dt = r > 6.0 ? r * 0.22 : clamp((r - 1.0) * 0.045 + 0.01, 0.01, 0.5);

    // Тонкая светящаяся оболочка у фотонной сферы. Это и есть кольцо затмения:
    // луч, идущий по касательной к тени, проходит внутри оболочки длинный
    // путь и набирает много света, а уходящий в сторону — почти нисколько.
    // Отсюда кольцо садится ровно на край тени, а не плавает снаружи, как
    // выходит, если ждать его от одного лишь фона.
    //
    // Копится отдельно: луч, который в итоге упал за горизонт, свой свет
    // не отдаёт. Иначе оболочку видно и сквозь тень, и вместо затмения
    // получается сплошное белое пятно во весь кадр.
    if (uLimb > 0.001 && r < 4.2) {
      float shell = exp(-pow((r - 1.9) / 0.55, 2.0));
      limbCol += mix(CORE, HOT, smoothstep(1.6, 3.4, r)) * shell * uLimb * dt;
    }

    vec3 acc = -1.5 * h2 * pos / (r2 * r2 * r);
    vec3 np = pos + vel * dt + 0.5 * acc * dt * dt;
    vec3 nv = vel + acc * dt;

    // Пересечение плоскости диска. Луч может пересечь её несколько раз —
    // так над тенью появляется «арка»: изнанка диска, поднятая гравитацией.
    if (uDisk > 0.001 && np.y * pos.y < 0.0) {
      float k = pos.y / (pos.y - np.y);
      vec3 hit = mix(pos, np, k);
      float rr = length(hit.xz);
      if (rr > RIN && rr < ROUT) col += diskColor(hit, vel);
    }

    pos = np;
    vel = nv;
  }

  if (captured < 0.5) {
    col += limbCol;
    vec3 d = normalize(vel);
    if (uSwirl > 0.001) {
      // Втягивание: чем ближе луч прошёл к дыре, тем сильнее его закрутило.
      float b = 1.0 / (1.0 + length(cross(normalize(ro), d)) * 3.0);
      d.xy = rot(uSwirl * b * 3.4) * d.xy;
      d = normalize(d);
    }
    col += sky(d) + backGlow(d);
  }
  return col;
}

/* ------------------------------------------------------- поверхность звезды --
   Акт, который держит середину: белое из вспышки оказывается не экраном,
   а фотосферой одного гиганта. Ячейки конвекции, потемнение к краю,
   спикулы и протуберанцы по лимбу.                                          */

uniform float uStarR;      // радиус в единицах полуэкрана по высоте
uniform float uStarAmt;

vec3 starSurface(vec2 uv, out float cover) {
  float R = max(uStarR, 1e-4);
  float d = length(uv) / R;
  cover = 1.0 - S(0.992, 1.0, d);

  vec3 c = vec3(0.0);

  if (d < 1.002) {
    float z = sqrt(max(1.0 - d * d, 0.0));
    vec3 n = normalize(vec3(uv / R, z + 0.02));

    // Проекция на касательную плоскость: к лимбу ячейки сжимаются сами,
    // как и положено сфере.
    vec2 tp = n.xy / (n.z + 0.35);
    tp *= rot(uTime * 0.012);

    vec3 c1 = cellF(tp * 7.5 + vec2(uTime * 0.05, 0.0));
    vec3 c2 = cellF(tp * 22.0 - vec2(0.0, uTime * 0.09));
    // Перемычки узкие: у настоящей грануляции тёмная сетка тоньше самих ячеек.
    float lane = smoothstep(0.01, 0.15, c1.y - c1.x);
    float fine = smoothstep(0.02, 0.20, c2.y - c2.x);
    float turb = fbm(vec3(tp * 7.0, uTime * 0.05), 4);
    // Разброс температуры от ячейки к ячейке.
    lane *= 0.55 + 0.75 * c1.z;
    fine *= 0.5 + 0.9 * c2.z;

    // Диапазон держится в середине лестницы намеренно: если довести верх до
    // единицы, вся фотосфера уходит в белое и от ячеек остаются только
    // жёлтые ниточки перемычек. Горячее — центры ячеек, а не всё подряд.
    float t = 0.22 + 0.26 * lane + 0.07 * fine + 0.12 * turb;

    // Потемнение к краю: без него шар читается наклейкой.
    float ld = pow(max(z, 0.0), 0.42);
    t *= 0.62 + 0.42 * ld;

    // Пятна: холодные области конвекции. Тёмное здесь всё равно тёплое.
    float sp = smoothstep(0.60, 0.82, fbm(vec3(tp * 2.6 + 11.0, uTime * 0.02), 4));
    t *= 1.0 - sp * 0.5;

    c = heat(clamp(t, 0.0, 1.0)) * (0.55 + 0.95 * ld);
  }

  // Лимб: спикулы частоколом и редкие протуберанцы-петли.
  float ang = atan(uv.y, uv.x);
  float rim = abs(d - 1.0);
  float spic = fbm(vec3(cos(ang) * 9.0, sin(ang) * 9.0, uTime * 0.25), 4);
  c += HOT * exp(-rim * 190.0) * (0.7 + 1.9 * spic) * 0.55;
  c += HOT * exp(-rim * 26.0) * 0.10;

  float pr = fbm(vec3(cos(ang) * 2.2, sin(ang) * 2.2, uTime * 0.08), 4);
  float loop = smoothstep(0.66, 0.92, pr) * exp(-max(d - 1.0, 0.0) * 22.0) * step(1.0, d);
  c += mix(DEEP, HOT, pr) * loop * 0.85;

  // Внешняя атмосфера: свет уходит в фон, а не обрывается кромкой.
  c += DEEP * exp(-max(d - 1.0, 0.0) * 5.5) * 0.11;

  return c * uStarAmt;
}

/* -------------------------------------------------------------------- кадр */

uniform vec3  uCamPos;
uniform mat3  uCamBasis;
uniform float uFov;
uniform float uHoleOn;
uniform float uFlash;
uniform float uWhite;

void main() {
  vec2 uv = (gl_FragCoord.xy - 0.5 * uRes) / uRes.y;

  vec3 col = vec3(0.0);

  // Луч. Паралакс от указателя — крошечный, он нужен телу, а не глазу:
  // сцена должна отзываться на движение, иначе это видео, а не аттракцион.
  vec3 rd = normalize(uCamBasis * vec3(uv * uFov + uPointer * 0.035, -1.0));

  float captured = 0.0;
  if (uHoleOn > 0.5) {
    col = raymarch(uCamPos, rd, captured);
  } else {
    col = sky(rd) + backGlow(rd);
  }

  if (uStarAmt > 0.001) {
    float cover;
    vec3 s = starSurface(uv, cover);
    col = mix(col, vec3(0.0), cover * 0.96) + s;
  }

  // Вспышка и белое поле. Свет заливает кадр целиком — это единственный
  // момент, когда на экране не остаётся ничего.
  col += CORE * uFlash;
  col = mix(col, CORE * 1.5, uWhite);

  col += BG;
  fragColor = vec4(col, 1.0);
}
