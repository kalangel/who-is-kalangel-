#version 300 es
precision highp float;

/* ============================================================================
   kalangel — «Затмение». Вся сцена: один фрагментный шейдер.

   Сквозная идея: тело, которое закрывает светило в первом акте, — это чёрная
   дыра. Кольцо затмения и есть кольцо Эйнштейна. Сайт не отвечает, кто такой
   kalangel, потому что ответ за горизонтом событий. В финале та же дыра
   съедает созвездие с ником и остаётся единственной дверью — в канал.

   Фотоны трассируются по геодезическим Шварцшильда (rs = 1, горизонт r = 1,
   фотонная сфера 1.5, ISCO 3). Кольцо, тень, изгиб фона, допплеровский перекос
   диска — не нарисованы, а посчитаны.

   Восемь актов на одном числе uPhase:
     0.00–0.13  затмение: тень, кольцо Эйнштейна, корона
     0.10–0.26  раскрытие: камера поднимается, диск загорается
     0.22–0.44  чёрная дыра целиком: тень, фотонное кольцо, лензированный диск
     0.42–0.53  падение к горизонту → вспышка → белое
     0.51–0.62  белое оказалось поверхностью гиганта: гранулы, протуберанцы
     0.60–0.84  отъезд: звезда сжимается в точку, небо густеет до тысяч звёзд
     0.72–0.86  самые яркие звёзды складываются в марку, фон отступает
     0.855–1.00 дыра возвращается, выпивает созвездие, горизонт остаётся дверью
   ============================================================================ */

out vec4 fragColor;
in vec2 vUv;

uniform vec2  uRes;
uniform float uTime;
uniform float uPhase;
uniform vec2  uPointer;      // −1..1, паралакс от указателя/наклона
uniform sampler2D uMark;     // маска вордмарка: r = светимость
uniform float uMarkAspect;   // ширина/высота вордмарка

#ifndef STEPS
#define STEPS 128
#endif

/* ---------------------------------------------------------------- палитра --
   Железное правило: ни одного холодного пикселя. Исключение ровно одно —
   точки звёзд, у них настоящие спектральные классы.                        */

const vec3 BG   = vec3(0.020, 0.012, 0.008);
const vec3 CORE = vec3(1.000, 0.957, 0.886);
const vec3 HOT  = vec3(1.000, 0.541, 0.122);
const vec3 DEEP = vec3(0.761, 0.255, 0.047);
const vec3 FADE = vec3(0.165, 0.059, 0.016);

const float RIN  = 3.0;      // ISCO: ближе диск не держится
const float ROUT = 17.0;

const float PI = 3.14159265;

/* ------------------------------------------------------------- утилиты ---- */

float S(float a, float b, float x) { return smoothstep(a, b, x); }

/** Колокол 0→1→0 внутри окна: для одноразовых событий вроде вспышки. */
float bump(float a, float b, float x) {
  float t = clamp((x - a) / max(b - a, 1e-4), 0.0, 1.0);
  return sin(t * PI);
}

mat2 rot(float a) { float c = cos(a), s = sin(a); return mat2(c, -s, s, c); }

float hash11(float p) {
  p = fract(p * 0.1031);
  p *= p + 33.33;
  return fract(p * (p + p));
}

vec4 hash42(vec2 p) {
  vec4 p4 = fract(vec4(p.xyxy) * vec4(0.1031, 0.1030, 0.0973, 0.1099));
  p4 += dot(p4, p4.wzxy + 33.33);
  return fract((p4.xxyz + p4.yzzw) * p4.zywx);
}

float hash13(vec3 p) {
  p = fract(p * 0.1031);
  p += dot(p, p.zyx + 31.32);
  return fract((p.x + p.y) * p.z);
}

float vnoise(vec3 p) {
  vec3 i = floor(p), f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float n = mix(
    mix(mix(hash13(i + vec3(0, 0, 0)), hash13(i + vec3(1, 0, 0)), f.x),
        mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y),
    mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),
        mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y),
    f.z);
  return n;
}

float fbm(vec3 p, int oct) {
  float a = 0.5, s = 0.0, n = 0.0;
  for (int i = 0; i < 6; i++) {
    if (i >= oct) break;
    s += a * vnoise(p);
    n += a;
    p *= 2.03;
    p.xy *= rot(0.7);
    a *= 0.5;
  }
  return s / max(n, 1e-4);
}

/** Клеточный шум: F2−F1 даёт тёмные перемычки между ячейками. Именно этим
 *  поверхность звезды отличается от размытого шума — у неё есть границы. */
vec3 cellF(vec2 p) {
  vec2 i = floor(p), f = fract(p);
  float f1 = 8.0, f2 = 8.0, id = 0.0;
  for (int y = -1; y <= 1; y++) {
    for (int x = -1; x <= 1; x++) {
      vec2 o = vec2(float(x), float(y));
      vec4 h = hash42(i + o);
      vec2 c = o + h.xy;
      float d = length(f - c);
      // Номер ближайшей ячейки возвращается третьим числом: без него все
      // гранулы одной температуры и поверхность читается сотами, а не
      // кипящим веществом.
      if (d < f1) { f2 = f1; f1 = d; id = h.z; } else if (d < f2) { f2 = d; }
    }
  }
  return vec3(f1, f2, id);
}

/** Тёплая температурная лестница. Заменяет физический планковский спектр:
 *  синий конец нам запрещён палитрой, а на диске он и так съеден красным
 *  смещением. Идёт от углей через оранжевый к почти белому ядру. */
vec3 heat(float t) {
  t = clamp(t, 0.0, 1.0);
  vec3 c = mix(vec3(0.06, 0.012, 0.004), FADE, S(0.0, 0.18, t));
  c = mix(c, DEEP, S(0.12, 0.42, t));
  c = mix(c, HOT,  S(0.38, 0.72, t));
  c = mix(c, CORE, S(0.66, 0.94, t));
  c = mix(c, vec3(1.0, 0.99, 0.98), S(0.9, 1.0, t));
  return c;
}

/** Ксеноновая лестница для гиганта. Второе — и последнее — место, где палитре
 *  разрешено холодное: так решено по картинке. Это не «синий вместо жёлтого»,
 *  а свет ксеноновой лампы: белое ядро с фиолетовым уходом в тень и с той самой
 *  голубой каймой по краю, по которой такую фару узнают. */
vec3 xenon(float t) {
  t = clamp(t, 0.0, 1.0);
  vec3 c = mix(vec3(0.035, 0.045, 0.105), vec3(0.13, 0.17, 0.38), S(0.0, 0.20, t));
  c = mix(c, vec3(0.33, 0.42, 0.78), S(0.16, 0.44, t));
  c = mix(c, vec3(0.62, 0.72, 1.00), S(0.40, 0.68, t));
  c = mix(c, vec3(0.88, 0.93, 1.00), S(0.62, 0.86, t));
  c = mix(c, vec3(1.00, 1.00, 1.00), S(0.84, 1.00, t));
  return c;
}

/** Спектральные классы. Единственное холодное место на сайте — и то точками:
 *  голубые сверхгиганты ломают жёлтую монотонность неба. */
vec3 starColor(float h) {
  vec3 c = mix(vec3(0.55, 0.66, 1.00), vec3(0.86, 0.90, 1.00), S(0.00, 0.16, h));
  c = mix(c, vec3(1.00, 1.00, 0.99), S(0.14, 0.34, h));
  c = mix(c, vec3(1.00, 0.93, 0.74), S(0.32, 0.60, h));
  c = mix(c, vec3(1.00, 0.72, 0.42), S(0.56, 0.82, h));
  c = mix(c, vec3(1.00, 0.49, 0.30), S(0.80, 1.00, h));
  return c;
}

/* ------------------------------------------------------------------ небо --
   Небо задано на сфере, а не на плоскости: иначе лензированный луч, который
   уходит вбок или назад, некуда девать. Проекция — на грани куба, у неё нет
   ни полюсов, ни шва по долготе.                                           */

/** Третьим выходом идёт `sec2` — во сколько раз координата грани растянута
 *  относительно угла в этом направлении. По нему считается размер пикселя в
 *  клетках, и считается непрерывно: из `fwidth` самой координаты грани он
 *  выходит бесконечным на каждом ребре куба, и по всем шести рёбрам небо
 *  расчерчивается светлыми линиями погашенных слоёв. Их и было видно. */
void cubeProject(vec3 d, out vec2 p, out float face, out float sec2) {
  vec3 a = abs(d);
  float m;
  if (a.z >= a.x && a.z >= a.y) {
    m = max(a.z, 1e-5);
    p = d.xy / m;
    face = d.z < 0.0 ? 0.0 : 1.0;   // грань 0 — «вперёд», на ней живёт марка
  } else if (a.x >= a.y) {
    m = max(a.x, 1e-5);
    p = d.zy / m;
    face = d.x < 0.0 ? 2.0 : 3.0;
  } else {
    m = max(a.y, 1e-5);
    p = d.xz / m;
    face = d.y < 0.0 ? 4.0 : 5.0;
  }
  sec2 = 1.0 / (m * m);
}

uniform float uMarkHalf;   // полуширина марки в координатах передней грани
uniform float uMarkAmt;    // 0 — марки нет, 1 — созвездие собрано

/** Насколько небо отступает ради рисунка. Пока имя собирается, общий фон
 *  гасится: на четырёх слоях звёзд рисунку нечем отличаться от крупы, и
 *  созвездия в кадре просто нет — проверено на телефоне. Возвращается фон
 *  к финалу, когда его всё равно забирает дыра. */
uniform float uMarkFocus;

/** Уровень детализации маски. Одна выборка обязана усреднить целую клетку:
 *  маска вчетверо-впятеро подробнее сетки, и точечная выборка ловит то
 *  засечку, то пустоту между штрихами — слово рассыпается. */
uniform float uMarkLod;

/** Шаг клеток слоя созвездия. Приходит снаружи: он считается от высоты окна,
 *  чтобы клетка всегда была около семи экранных пикселей. Константа здесь
 *  означала бы, что на телефоне созвездие или сливается в пятно, или
 *  рассыпается на десяток точек. */
uniform float uMarkDensity;

float markAt(vec2 p) {
  vec2 t = p / vec2(uMarkHalf, uMarkHalf / uMarkAspect);
  if (abs(t.x) > 1.0 || abs(t.y) > 1.0) return 0.0;
  vec2 uv = t * 0.5 + 0.5;
  // Уровень задан снаружи, а не выведен из производных: выборка стоит внутри
  // цикла с `continue`, а там неявный LOD не определён.
  return textureLod(uMark, vec2(uv.x, 1.0 - uv.y), uMarkLod).r;
}

/** Четырёхлучевая дифракция: вертикальные лучи длинные, горизонтальные
 *  короткие. Та же геометрия, что у звезды в логотипе, — небо и марка
 *  сделаны из одного элемента. */
float spikes(vec2 q, float len) {
  vec2 a = abs(q);
  // Затухание экспоненциальное, и хвост у него длинный: множитель на длину
  // здесь стоит скромный не по робости, а потому что при большом луч тянется
  // через полэкрана и небо превращается в дождь.
  float v = exp(-a.y / (len * 0.85)) * exp(-a.x * 2.6);
  float h = exp(-a.x / (len * 0.34)) * exp(-a.y * 3.2);
  return v + h * 0.7;
}

uniform float uSkyDensity;
uniform float uSkyGain;

/** `field` — во сколько раз приглушены рядовые звёзды слоя. Для обычного неба
 *  это единица; слой созвездия существует ради рисунка, и его собственное
 *  небо задавлено, иначе поверх четырёх слоёв ложится пятый, самый частый. */
vec3 starLayer(vec3 dir, float density, float amp, float seed, float markAmt, float field) {
  vec2 p; float face; float sec2;
  cubeProject(dir, p, face, sec2);

  vec2 sp = p * density + face * 137.0;
  vec2 id = floor(sp);
  vec2 fp = fract(sp);
  // Размер пикселя в клеточных единицах: звёзды рисуются в экранных пикселях,
  // поэтому остаются точками на любом зуме и не превращаются в кляксы.
  //
  // Берётся он от направления луча, а не от координаты грани. Координата на
  // ребре куба меняется скачком, `fwidth` там взрывается, слой гаснет — и по
  // небу идут светлые линии рёбер. От направления производная непрерывна, а
  // растяжение грани учитывает sec². Под линзой всё работает как прежде:
  // растянутый пучок лучей даёт большой fwidth(dir) и там же гасит слой.
  float px = max(length(fwidth(dir)) * sec2 * density, 1e-5);

  // Мип. Когда клетка мельче пикселя, отдельную звезду не разрешить: каждая
  // клетка оказывается «в центре» и слой заливает экран ровным молоком.
  // Такой слой обязан гаснуть, а не светиться. Это же снимает пунктир из
  // размазанных звёзд у самой линзы, где производная взрывается.
  // Окно широкое намеренно. При обычном взгляде клетка держится в 8–11
  // пикселях, то есть далеко от нижней границы, и окно не работает вовсе.
  // Работает оно только там, где линза растягивает клетки, — и там слой обязан
  // дожить до полос, а не исчезнуть: лензированное небо и выглядит полосами.
  float mip = 1.0 - smoothstep(0.25, 1.40, px);
  // Погашенный слой отдаёт свой средний свет, а не ноль. Иначе там, где линза
  // растягивает клетки — то есть вокруг подходящей дыры, — в небе появляется
  // ЧЁРНЫЙ пузырь во весь экран, и дыра читается не приближением, а дырой,
  // пробитой в кадре. Средним же она читается размазанным светом.
  vec3 smear = mix(CORE, HOT, 0.45) * amp * 0.035 * (1.0 - mip);
  if (mip < 0.002) return smear;

  vec3 acc = vec3(0.0);
  for (int y = -1; y <= 1; y++) {
    for (int x = -1; x <= 1; x++) {
      vec2 o = vec2(float(x), float(y));
      vec4 h = hash42(id + o + seed);
      if (h.w > 0.72) continue;              // не в каждой клетке звезда

      // Разброс почти на всю клетку. При скромном джиттере сетка клеток
      // читается глазом как решётка — небо сразу превращается в текстуру.
      vec2 sPos = o + 0.06 + h.xy * 0.88;

      // Величина: степень делает большинство звёзд слабыми, а несколько —
      // яркими. Равномерное распределение читается манной крупой.
      float mag = pow(h.z, 5.0);

      float mk = 0.0;
      float born = 1.0;
      if (face < 0.5 && markAmt > 0.001) {
        // Порог по маске: у буквы обязана быть граница. Без него значения
        // маски размазываются полутонами, и вместо начертания выходит облако.
        float inMark = smoothstep(0.30, 0.70, markAt((id + sPos - face * 137.0) / density));

        // Созвездие собирается ПОЗВЁЗДНО, а не проявляется целиком. У каждой
        // клетки свой срок: пока он не подошёл, звезды нет, подошёл — она
        // загорается сразу в полную силу и приезжает на место со стороны.
        // Общая яркость на весь рисунок давала ровно то, что видно на снимке:
        // буро-серый призрак слова, который непонятно что такое.
        float birth = fract(h.z * 3.71 + h.w * 11.37);
        born = smoothstep(birth * 0.92, birth * 0.92 + 0.16, markAmt);
        mk = inMark * born;
        sPos += (h.xy - 0.5) * 1.5 * (1.0 - born) * inMark;
      }

      vec2 dv = (fp - sPos) / px;
      float dp = length(dv);
      if (dp > 90.0) continue;
      // В марке звезда не дорисовывается, а повышается в классе: рисунок
      // складывается из тех же звёзд, что и всё небо. Порог по h.w оставляет
      // в марке не все клетки — созвездие должно быть россыпью, а не заливкой.
      // Две трети клеток, а не четверть: на телефоне на всё слово приходится
      // около сотни клеток по ширине — по десятку с небольшим на букву. Это
      // ровно тот предел, за которым точечный шрифт перестаёт читаться, и
      // выкидывать оттуда три четверти точек значит не иметь букв вовсе.
      float pick = step(h.w, 0.62);
      // Разброс величин сохраняется: если поднять все клетки марки к одному
      // потолку, созвездие выходит ровной наклейкой, а не россыпью.
      mag = mix(mag, max(mag, 0.45 + 0.5 * h.z), mk * pick);

      float tw = 0.78 + 0.22 * sin(uTime * (0.7 + h.x * 2.6) + h.y * 41.0);
      float b = amp * (0.02 + mag * 1.6) * tw * (1.0 + mk * 3.0) * mix(field, 1.0, mk * pick);

      float core = exp(-dp * dp * 0.62);
      float halo = 0.35 / (1.0 + dp * dp * 1.8);
      // Класс берётся из отдельного числа, а не из яркости. Связать их — значит
      // покрасить все крупные звёзды в один конец спектра: небо станет ржавым.
      vec3 col = starColor(fract(h.x * 7.31 + h.y * 3.17));

      acc += col * (core + halo * 0.5) * b;

      // Лучи — редкость, и в марке особенно. Клетка там всего в несколько
      // пикселей, а луч тянется на два десятка: если лучи выдать всем звёздам
      // рисунка, соседние буквы слипаются в одно светящееся пятно. Их получает
      // примерно каждая пятая — те самые опорные звёзды созвездия.
      float spikeOn = step(0.42, mag) * mix(1.0, step(0.78, h.y), mk * pick);
      if (spikeOn > 0.5) {
        acc += col * spikes(dv, 1.4 + mag * 6.0) * b * (0.3 + mk * 0.5);
      }
    }
  }
  return acc * mip;
}

/** Пыль и рукав галактики. Под дырой это слабая структура, которую не должно
 *  быть заметно. К звёздным актам она разгорается в светящуюся туманность:
 *  небо там намеренно нереалистичное — оно светит, а не просто держит точки.
 *  Множитель приходит снаружи (`uNebula`). */
uniform float uNebula;

/** Хребтовый шум. Обычный fbm даёт пятна, а `1 − |2n−1|` — гребни: волокна,
 *  жгуты, рваные края. Именно по ним туманность читается веществом, а не
 *  градиентом, и именно их не хватало небу. */
float rnoise(vec3 p, int oct) {
  float a = 0.5, s = 0.0, n = 0.0;
  for (int i = 0; i < 6; i++) {
    if (i >= oct) break;
    float v = 1.0 - abs(vnoise(p) * 2.0 - 1.0);
    s += a * v * v;
    n += a;
    p *= 2.17;
    p.yz *= rot(1.1);
    a *= 0.55;
  }
  return s / max(n, 1e-4);
}

/**
 * Млечный путь. Отдаёт наружу три вещи, и все три нужны:
 *
 *  • свечение — возвращаемое значение: неразрешённые звёзды полосы и эмиссия
 *    в узлах;
 *  • `ext` — поглощение. Тёмные прожилки пыли гасят звёзды ЗА собой. Это
 *    главный источник глубины: небо перестаёт быть ровной крупой не от того,
 *    что где-то светлее, а от того, что где-то что-то заслонено;
 *  • `boost` — сгущение. Вдоль полосы звёзд больше и они ярче, вне её небо
 *    редеет. Ровная плотность по всему кадру — первый признак генератива.
 */
vec3 galaxy(vec3 d, out float ext, out float boost) {
  // Полоса и поперечный рукав оставлены как были: на них стоит композиция
  // звёздных актов, и трогать её здесь незачем.
  float warp = fbm(d * 1.7, 2);
  float y = d.y * 2.4 + warp * 0.5 - 0.25;
  float band = exp(-y * y * 5.0);
  float arm = exp(-pow(d.x * 1.9 - d.z * 0.8 + fbm(d * 2.3 + 7.0, 2) * 0.9 - 0.1, 2.0) * 3.0);
  float body = band + arm * 0.55;

  float fil = rnoise(d * 3.4, 4);          // крупные волокна
  float knot = pow(rnoise(d * 9.5 + 21.0, 3), 3.0);  // яркие узлы
  float fine = fbm(d * 16.0, 2);           // зернистость поверх

  // Пыль. Прожилки вытянуты вдоль полосы (по вертикали шум частит вчетверо) —
  // так они режут её поперёк на куски, как и положено тёмным облакам.
  float lane = fbm(vec3(d.xz * 4.6, d.y * 15.0) + 3.0, 4);
  float dark = smoothstep(0.44, 0.76, lane) * (0.35 + 0.65 * body);
  ext = 1.0 - 0.80 * dark;

  boost = body * (0.35 + 0.9 * fil);

  // Волокно возводится в степень намеренно. Без неё туманность кроет кадр
  // ровным бурым дымом от края до края: света много, вещества не видно, а
  // созвездию нечем от него отличаться. Степень выедает середину и оставляет
  // жгуты с чёрным между ними.
  float web = pow(fil, 1.7);
  float lum = body * (0.10 + 1.15 * web) * (0.45 + 1.0 * fine);
  vec3 c = mix(FADE * 0.75, DEEP * 0.5, web);
  c = mix(c, mix(HOT, CORE, 0.28) * 0.66, knot * 0.9);
  return c * lum * 0.115 * uNebula * ext;
}

vec3 sky(vec3 d) {
  float D = uSkyDensity;

  // Пока собирается имя, общее небо отступает — иначе рисунок тонет в крупе.
  float bg = 1.0 - 0.68 * uMarkFocus;

  float ext, boost;
  vec3 c = galaxy(d, ext, boost) * bg;

  // Поглощение и сгущение идут ко всем слоям сразу. Пыль гасит звёзды за
  // собой, полоса их сгущает — небо получает рельеф, которого не даёт ни
  // одна прибавка яркости.
  float a0 = ext * (0.80 + 0.85 * boost) * bg;

  // Множители слоёв разведены вчетверо: каждый следующий кроет экран вчетверо
  // гуще предыдущего. Звёзд в кадре у слоя ∼ (D·множитель)², поэтому счёт
  // держит последний слой — он и обязан входить дольше всех.
  c += starLayer(d, D * 1.60, 1.00 * a0, 11.0, 0.0, 1.0);
  c += starLayer(d, D * 3.60, 0.70 * a0, 57.0, 0.0, 1.0);

  // Дальние слои включаются только на отъезде: вблизи дыры они не видны, а
  // стоят столько же. Но включаются ЯРКОСТЬЮ, а не порогом. Порог был
  // ступенькой: на одном движении пальца плотность переходила 1.9, и пустое
  // небо разом становилось сплошной крупой — ровно то, что видно на снимках.
  // Ветвление осталось, но срабатывает оно там, где слой ещё не виден.
  // Окна разгона широкие и с большим перекрытием. Узкое окно у самого частого
  // слоя — это и есть скачок: он один определяет, сколько звёзд в кадре.
  float a3 = 0.45 * S(1.30, 2.60, D);
  if (a3 > 0.004) c += starLayer(d, D * 7.50, a3 * a0, 91.0, 0.0, 1.0);
  float a4 = 0.28 * S(1.90, 3.90, D);
  if (a4 > 0.004) c += starLayer(d, D * 15.0, a4 * a0, 23.0, 0.0, 1.0);
  // Пятый слой — та самая глубина: тысячи слабых звёзд, из-за которых небо
  // перестаёт быть точками на чёрном. Он включается последним и почти под
  // самый финал, где его и забирает дыра.
  float a5 = 0.18 * S(3.10, 4.60, D);
  if (a5 > 0.004) c += starLayer(d, D * 30.0, a5 * a0, 149.0, 0.0, 1.0);

  // У созвездия свой слой с фиксированным шагом. Привязать рисунок к общей
  // плотности неба нельзя: на крупных слоях шаг клетки — сотни пикселей, и
  // на весь логотип приходится пяток звёзд. Шаг здесь выбран так, чтобы на
  // марку легли сотни клеток, — только тогда из точек читается начертание.
  // Рядовые звёзды этого слоя приглушены: он самый частый из всех, и в полную
  // силу он не помогает рисунку, а хоронит его. И приглушены они тем сильнее,
  // чем меньше собрано имя: слой обязан входить вместе с рисунком, а не
  // впрыгивать в кадр целым небом на пороге.
  if (uMarkAmt > 0.004) {
    // Яркость слоя постоянна: гаснуть и разгораться должна отдельная звезда,
    // а не рисунок целиком.
    c += starLayer(d, uMarkDensity, 0.62, 313.0, uMarkAmt, 0.10 * bg * uMarkAmt);
  }

  return c * uSkyGain;
}

/* --------------------------------------------------------- фоновое светило --
   Источник ровно за дырой. Луч, обогнувший тень, приносит его свет обратно в
   кадр — так получается кольцо. Оно не нарисовано: это тот же источник,
   размазанный гравитацией по окружности.                                    */

uniform vec3  uLightDir;
uniform float uGlow;

vec3 backGlow(vec3 d) {
  if (uGlow < 0.001) return vec3(0.0);

  float c = dot(d, uLightDir);
  float a = max(1.0 - c, 0.0);   // ≈ θ²/2
  float rad = sqrt(a);           // ≈ угол до оси, делённый на √2

  // Самого светила в кадре нет, и это решение, а не упущение. Точечный
  // источник ровно за дырой виден только своим кольцом Эйнштейна — тонким
  // ровным обручем далеко снаружи тени, во весь экран и обрезанным его
  // краями. Спека (§6.2) на этот счёт однозначна: кольцо затмения приходит от
  // оболочки у фотонной сферы и садится на кромку тени, а второго кольца в
  // композиции нет. Остаётся то, что и должно быть видно при затмении, —
  // корона.

  // Корона протяжённая, поэтому её свет ложится ЗА кольцом, снаружи тени.
  vec3 t = normalize(cross(uLightDir, vec3(0.0, 1.0, 0.0)) + vec3(1e-4));
  vec3 b = cross(uLightDir, t);
  float az = atan(dot(d, b), dot(d, t));

  // Лучи, а не ровное гало. Главное здесь — что длина луча зависит от
  // азимута: у ровного затухания корона выходит бубликом с шумом по яркости,
  // и это читается засветкой объектива. У настоящей короны одни стримеры
  // уходят на два радиуса, другие обрываются у самой кромки.
  float k1 = fbm(vec3(cos(az) * 3.0, sin(az) * 3.0, uTime * 0.03), 3);         // пучки
  float k2 = fbm(vec3(cos(az) * 11.0, sin(az) * 11.0, uTime * 0.05 + 11.0), 3); // лучи
  float k3 = fbm(vec3(cos(az) * 26.0, sin(az) * 26.0, uTime * 0.09 + 31.0), 2); // волоски

  // Степени высокие намеренно: они оставляют от шума узкие гребни. Ровный шум
  // по азимуту даёт бублик с неровной яркостью, а не лучи, и такой кадр
  // читается засветкой объектива.
  float beam = pow(k2, 2.6) * (0.40 + 1.4 * pow(k3, 2.0));
  float len = 0.055 + 0.34 * pow(k1, 1.3) * (0.30 + 1.2 * k2);
  float cor = exp(-rad / len) * (0.16 + 2.2 * beam);

  // Основание короны: плотный, мелко изрезанный воротник у самой кромки. Без
  // него стримеры растут из пустоты, и корона не связана с телом.
  cor += exp(-rad * 24.0) * (0.45 + 1.4 * pow(k3, 1.6)) * 0.85;

  // Цвет идёт по радиусу: у основания почти белый, к концам лучей — угли.
  // Одним оттенком корона красится плоско, и вся работа с лучами пропадает.
  vec3 cc = mix(mix(CORE, HOT, 0.55), DEEP * 0.9, S(0.03, 0.26, rad));
  return cc * cor * 0.17 * uGlow;
}

/* -------------------------------------------------------- аккреционный диск */

uniform float uDisk;

vec3 diskColor(vec3 hit, vec3 vel) {
  float r = length(hit.xz);
  float a = atan(hit.z, hit.x);

  // Кеплеровский сдвиг: внутренние кольца обгоняют внешние.
  float w = uTime * 1.15 * pow(r, -1.5) * 4.0;
  float th = a - w;

  // Логарифмическая спираль. Сдвиг по углу растёт с log r, поэтому волокна
  // вытягиваются в спиральные жгуты, а не в концентрические кольца: кольца —
  // это то, во что диск сворачивается сам, если структуру просто крутить.
  // Выборка идёт через cos/sin угла: у неё нет шва на ±π.
  float s1 = th + log(r) * 2.4;
  float s2 = th + log(r) * 5.6;
  float lr = log(r);

  // Три частоты вместо двух, и все три — выше прежних. Крупный шум шёл с
  // шагом в треть диска: на весь кадр приходилось три пятна, и после блума от
  // структуры не оставалось ничего. Отсюда и была «кремовая клякса».
  float nBig  = fbm(vec3(cos(s1) * 2.1, sin(s1) * 2.1, lr * 2.4), 3);
  float nMid  = fbm(vec3(cos(s2) * 4.6, sin(s2) * 4.6, lr * 6.5), 3);
  float nFine = vnoise(vec3(cos(s2) * 15.0, sin(s2) * 15.0, lr * 19.0));

  // Хребет по крупному шуму даёт жгуты, средний их рвёт, мелкий добавляет
  // зерно. Волокна, а не вата.
  float ridge = 1.0 - abs(nBig * 2.0 - 1.0);
  float fil = pow(clamp(ridge * 1.35, 0.0, 1.0), 1.6) * (0.30 + 1.25 * nMid);
  fil *= 0.72 + 0.56 * nFine;

  // Температура по радиусу: T ~ r^(-3/4). Волокно подмешивается в неё же:
  // плотный жгут не только ярче, но и горячее — иначе диск красится одним
  // радиальным градиентом и читается напечатанным.
  float T = pow(RIN / r, 0.75) * (0.88 + 0.26 * fil);
  vec3 c = heat(T * 0.98);

  // Плотность: внутренняя кромка обрывается на ISCO, внешняя растворяется.
  // Кромка узкая: на ISCO вещество кончается, а не сходит на нет.
  float env = S(RIN, RIN * 1.07, r) * (1.0 - S(ROUT * 0.55, ROUT, r));
  float dens = env * (0.09 + 1.05 * fil);

  // Допплер. Половина диска, идущая на зрителя, светит в разы сильнее — это
  // и есть тот самый перекос, по которому дыру узнают.
  vec3 orb = normalize(cross(vec3(0.0, 1.0, 0.0), hit));
  float beta = 0.52 * sqrt(RIN / r);
  float g = 1.0 / max(1.0 - beta * dot(orb, -normalize(vel)), 0.16);
  // Потолок нужен: без него приближающийся край уходит в единственное белое
  // пятно и съедает всю структуру диска, ради которой всё и считалось.
  float dop = min(pow(g, 3.2), 9.0);

  // Гравитационное красное смещение: у горизонта свет вязнет.
  float grav = sqrt(max(1.0 - 1.0 / r, 0.02));

  float bright = pow(RIN / r, 1.9) * 0.30;
  return c * dens * bright * dop * grav * uDisk;
}

/* ------------------------------------------------------- геодезики фотонов --
   Уравнение орбиты фотона в метрике Шварцшильда, записанное как ускорение
   в декартовых координатах: a = −3/2 · h² · r⃗ / r⁵ при rs = 1.
   Горизонт — r = 1, фотонная сфера — 1.5.                                   */

uniform float uSwirl;   // финал: закрутка фона по мере втягивания
uniform float uLimb;    // свечение у фотонной сферы: кольцо затмения

vec3 raymarch(vec3 ro, vec3 rd, out float captured) {
  vec3 pos = ro;
  vec3 vel = rd;

  // Прицельный параметр прямой траектории (|rd| = 1). Он сохраняется вдоль
  // прямой, поэтому по нему можно судить о луче ещё до интегрирования.
  float b = length(cross(pos, vel));
  float toward = -dot(pos, vel);

  // Дальний перелёт — по прямой. На таких радиусах ускорение (∼h²/r⁵) гнёт луч
  // меньше, чем на пиксель, а честными шагами перелёт съедает весь бюджет: в
  // финале камера приходит с пятисот радиусов, и до дыры луч бы не долетел —
  // оборвался бы по счётчику и был засчитан пойманным, то есть чёрным.
  // Тень при этом не смещается ни на пиксель: захват решает прицельный
  // параметр, а он у прямой ровно тот же.
  if (toward > 0.0) {
    float rIn = max(b, 42.0);
    pos += vel * max(toward - sqrt(max(rIn * rIn - b * b, 0.0)), 0.0);
  }

  float h2 = dot(cross(pos, vel), cross(pos, vel));

  vec3 col = vec3(0.0);
  vec3 limbCol = vec3(0.0);
  captured = 1.0;
  // Признак ухода: луч удаляется и вышел за область, где его ещё гнёт. Потолок
  // нужен по той же причине, что и перелёт по прямой, — иначе при камере на
  // пятистах радиусах «ушедшим» луч признаётся только через пятьсот.
  float far = max(min(length(ro) + 8.0, 60.0), 2.4 * b);

  for (int i = 0; i < STEPS; i++) {
    float r2 = dot(pos, pos);
    float r = sqrt(r2);

    if (r < 1.0) break;
    // Обрыв по шагам — не «луч ушёл». Тот, кто за весь бюджет так и не
    // выбрался, наматывает витки у фотонной сферы: он пойман. Считать его
    // ушедшим — значит вывесить вокруг тени венок ложных колец из фона.
    if (r > far && dot(pos, vel) > 0.0) { captured = 0.0; break; }

    // Шаг двухрежимный. Вдали траектория почти прямая, и подробничать там —
    // значит потратить весь бюджет на пустой перелёт: на телефоне с его
    // восемью десятками шагов луч тогда не долетает до дыры, обрывается по
    // счётчику, считается пойманным, и кадр становится сплошь чёрным.
    // Вблизи наоборот: крупный шаг накапливает ошибку, лучи с околокритическим
    // прицелом валятся внутрь, и тень раздувается против теоретической.
    // Третий режим — для перелёта: за двумя десятками радиусов траектория
    // почти прямая, и мельчить там нечем оправдать.
    float dt = r > 24.0 ? r * 0.42
             : (r > 6.0 ? r * 0.22 : clamp((r - 1.0) * 0.045 + 0.01, 0.01, 0.5));

    // Тонкая светящаяся оболочка у фотонной сферы. Это и есть кольцо затмения:
    // луч, идущий по касательной к тени, проходит внутри оболочки длинный
    // путь и набирает много света, а уходящий в сторону — почти нисколько.
    // Отсюда кольцо садится ровно на край тени, а не плавает снаружи, как
    // выходит, если ждать его от одного лишь фона.
    //
    // Копится отдельно: луч, который в итоге упал за горизонт, свой свет
    // не отдаёт. Иначе оболочку видно и сквозь тень, и вместо затмения
    // получается сплошное белое пятно во весь кадр.
    if (uLimb > 0.001 && r < 4.2) {
      // Оболочка узкая: по спеке кольцо на лимбе тонкое. Широкая давала
      // белый вал в полтора радиуса тени — не кромку, а второй диск.
      float shell = exp(-pow((r - 1.78) / 0.34, 2.0));
      // Второй, широкий и слабый слой. Он не кольцо, а его подсвет: без него
      // между кромкой и короной остаётся чёрный ров в полтени шириной, и
      // кольцо висит в пустоте вместо того, чтобы переходить в корону.
      shell += exp(-pow((r - 2.8) / 2.2, 2.0)) * 0.014;
      limbCol += mix(CORE, HOT, smoothstep(1.6, 3.4, r)) * shell * uLimb * dt * 1.5;
    }

    vec3 acc = -1.5 * h2 * pos / (r2 * r2 * r);
    vec3 np = pos + vel * dt + 0.5 * acc * dt * dt;
    vec3 nv = vel + acc * dt;

    // Пересечение плоскости диска. Луч может пересечь её несколько раз —
    // так над тенью появляется «арка»: изнанка диска, поднятая гравитацией.
    // Радиус в условии — не оптимизация: диск кончается на ROUT = 17, а на
    // перелёте шаг длиннее самого диска, и линейная точка пересечения там
    // выдумана. Вне этого радиуса пересекать нечего.
    if (uDisk > 0.001 && r < 24.0 && np.y * pos.y < 0.0) {
      float k = pos.y / (pos.y - np.y);
      vec3 hit = mix(pos, np, k);
      float rr = length(hit.xz);
      if (rr > RIN && rr < ROUT) col += diskColor(hit, vel);
    }

    pos = np;
    vel = nv;
  }

  if (captured < 0.5) {
    col += limbCol;
    vec3 d = normalize(vel);
    if (uSwirl > 0.001) {
      // Втягивание: чем ближе луч прошёл к дыре, тем сильнее его закрутило.
      //
      // Профиль — квадратичный, и это не вкусовщина. У прежнего `1/(1+3s)`
      // производная на оси равна −3: угол поворота менялся втрое быстрее, чем
      // сам угол зрения, клетки звёзд растягивались, мип гасил слои, и вокруг
      // подходящей дыры в небе открывался диск с резной кромкой. Здесь
      // производная на оси нулевая: у самой оси закрутка идёт как жёсткое
      // вращение, и растягивать нечего.
      float s = length(cross(normalize(ro), d));
      float b = 1.0 / (1.0 + s * s * 9.0);
      d.xy = rot(uSwirl * b * 3.4) * d.xy;
      d = normalize(d);
    }
    col += sky(d) + backGlow(d);
  }
  return col;
}

/* ------------------------------------------------------- поверхность звезды --
   Акт, который держит середину: белое из вспышки оказывается не экраном,
   а фотосферой одного гиганта. Ячейки конвекции, потемнение к краю,
   спикулы и протуберанцы по лимбу.                                          */

uniform float uStarR;      // радиус в единицах полуэкрана по высоте
uniform float uStarAmt;

vec3 starSurface(vec2 uv, out float cover) {
  float R = max(uStarR, 1e-4);
  float d = length(uv) / R;
  cover = 1.0 - S(0.992, 1.0, d);

  vec3 c = vec3(0.0);

  if (d < 1.002) {
    float z = sqrt(max(1.0 - d * d, 0.0));
    vec3 n = normalize(vec3(uv / R, z + 0.02));

    // Проекция на касательную плоскость: к лимбу ячейки сжимаются сами,
    // как и положено сфере.
    vec2 tp = n.xy / (n.z + 0.35);
    tp *= rot(uTime * 0.012);

    // Турбулентная деформация координат — главное, чего не хватало. Без неё
    // ячейки остаются правильными многоугольниками, и шар читается кракелюром
    // на фарфоре, а не кипящим веществом: у конвекции границы рваные, потому
    // что их таскает само течение.
    vec2 wq = vec2(fbm(vec3(tp * 2.7, uTime * 0.06), 3),
                   fbm(vec3(tp * 2.7 + 19.0, uTime * 0.06), 3)) - 0.5;
    tp += wq * 0.42;

    // Три масштаба: супергрануляция, грануляция и зерно. На двух поверхность
    // держится одним размером ячейки и читается сеткой.
    vec3 c0 = cellF(tp * 3.1 + vec2(uTime * 0.02, 0.0));
    vec3 c1 = cellF(tp * 9.5 + vec2(uTime * 0.05, 0.0));
    vec3 c2 = cellF(tp * 27.0 - vec2(0.0, uTime * 0.09));

    // Гранула — не многоугольник с обводкой. У неё горячая середина, свет от
    // которой спадает к краю, и уже на краю — тонкая тёмная перемычка. Одного
    // F2−F1 мало: он даёт ровные ячейки в тёмной сетке, то есть кракелюр.
    // Купол по F1 (расстоянию до центра ячейки) и есть то, чего не хватало.
    float dome0 = 1.0 - smoothstep(0.05, 0.70, c0.x);
    float dome1 = 1.0 - smoothstep(0.03, 0.55, c1.x);
    float dome2 = 1.0 - smoothstep(0.02, 0.50, c2.x);

    // Перемычки мягкие. Узкий порог обводил каждую ячейку чернильным контуром;
    // у настоящей грануляции переход от горячего к тёмному — градиент.
    float sup  = smoothstep(0.0, 0.30, c0.y - c0.x) * (0.40 + 0.85 * dome0);
    float lane = smoothstep(0.0, 0.16, c1.y - c1.x) * (0.40 + 0.90 * dome1);
    float fine = smoothstep(0.0, 0.13, c2.y - c2.x) * (0.45 + 0.80 * dome2);
    float turb = fbm(vec3(tp * 6.0, uTime * 0.05), 4);
    // Разброс температуры от ячейки к ячейке.
    lane *= 0.48 + 0.85 * c1.z;
    fine *= 0.45 + 0.95 * c2.z;
    sup  *= 0.60 + 0.70 * c0.z;

    // Диапазон держится в середине лестницы намеренно: если довести верх до
    // единицы, вся фотосфера уходит в белое и от ячеек остаются только
    // ниточки перемычек. Горячее — центры ячеек, а не всё подряд.
    // Размах по лестнице широкий: перемычки уходят в глубокую синь, центры
    // ячеек выбиваются за белое и там их подхватывает блум. Узкий размах и
    // давал лёд в трещинах вместо света: и дно, и верх сидели в одной, самой
    // светлой трети ксеноновой лестницы.
    float t = 0.02 + 0.13 * sup + 0.44 * lane + 0.13 * fine + 0.10 * turb;

    // Потемнение к краю. Сильное: именно оно делает из диска шар, и именно
    // оно уводит лимб в холодный конец ксеноновой лестницы — та самая синяя
    // кайма, по которой такую лампу узнают.
    float ld = pow(max(z, 0.0), 0.58);
    t *= 0.44 + 0.62 * ld;

    // Поры и пятна: холодные провалы конвекции. Тёмное здесь всё равно
    // остаётся в ксеноне, а не уходит в серое.
    float sp = smoothstep(0.58, 0.84, fbm(vec3(tp * 2.2 + 11.0, uTime * 0.02), 4));
    float pore = smoothstep(0.72, 0.95, fbm(vec3(tp * 11.0 + 5.0, uTime * 0.04), 3));
    t *= 1.0 - sp * 0.42 - pore * 0.30;

    // Диапазон держится ниже белого. Подтянутый вверх, он с блумом выжигает
    // фотосферу в лист бумаги: ни ячеек, ни того голубого, ради которого
    // ксенон и берётся.
    // Множитель уходит выше единицы к центру диска — именно этот запас
    // собирает блум, и именно из-за его отсутствия шар светился ровно, как
    // наклейка. К лимбу он падает втрое: потемнение к краю обязано быть
    // видно, а не подразумеваться.
    c = xenon(clamp(t * 1.15, 0.0, 1.0)) * (0.30 + 1.25 * ld);
  }

  // Лимб: спикулы частоколом и редкие протуберанцы-петли.
  const vec3 XHOT = vec3(0.66, 0.79, 1.00);
  const vec3 XDEEP = vec3(0.30, 0.42, 0.88);

  float ang = atan(uv.y, uv.x);
  float rim = abs(d - 1.0);
  // Спикулы: частокол по кромке. Частота высокая, степень резкая — иначе это
  // не частокол, а ровный светящийся кант, и он съедает потемнение к краю,
  // ради которого диск и темнеет.
  float spic = fbm(vec3(cos(ang) * 26.0, sin(ang) * 26.0, uTime * 0.25), 3);
  float spic2 = fbm(vec3(cos(ang) * 7.0, sin(ang) * 7.0, uTime * 0.13 + 3.0), 3);
  c += XHOT * exp(-rim * 240.0) * (0.35 + 2.4 * pow(spic, 2.0)) * 0.34;
  c += XHOT * exp(-rim * 60.0) * pow(spic2, 2.2) * 0.30;
  c += XHOT * exp(-rim * 26.0) * 0.07;

  float pr = fbm(vec3(cos(ang) * 2.2, sin(ang) * 2.2, uTime * 0.08), 4);
  float loop = smoothstep(0.66, 0.92, pr) * exp(-max(d - 1.0, 0.0) * 22.0) * step(1.0, d);
  c += mix(XDEEP, XHOT, pr) * loop * 0.85;

  // Внешняя атмосфера: свет уходит в фон, а не обрывается кромкой.
  c += XDEEP * exp(-max(d - 1.0, 0.0) * 5.5) * 0.11;

  return c * uStarAmt;
}

/* -------------------------------------------------------------------- кадр */

uniform vec3  uCamPos;
uniform mat3  uCamBasis;
uniform float uFov;
uniform float uHoleOn;
uniform float uFlash;
uniform float uWhite;

/** Проявление линзы. Зона сильного лензирования занимает на экране радиус
 *  ∼√(rs/D): даже с семисот радиусов это сотня пикселей. Отодвинуть дыру
 *  настолько, чтобы зона стала меньше звезды, нельзя — до тысяч радиусов, — а
 *  значит в первый кадр акта она иначе как пятном не появится. Поэтому первые
 *  четверть экрана прокрутки линза подмешивается к чистому небу. */
uniform float uLensFade;

void main() {
  vec2 uv = (gl_FragCoord.xy - 0.5 * uRes) / uRes.y;

  vec3 col = vec3(0.0);

  // Луч. Паралакс от указателя — крошечный, он нужен телу, а не глазу:
  // сцена должна отзываться на движение, иначе это видео, а не аттракцион.
  vec3 rd = normalize(uCamBasis * vec3(uv * uFov + uPointer * 0.035, -1.0));

  float captured = 0.0;
  if (uHoleOn > 0.5) {
    col = raymarch(uCamPos, rd, captured);
    if (uLensFade < 0.995) col = mix(sky(rd) + backGlow(rd), col, uLensFade);
  } else {
    col = sky(rd) + backGlow(rd);
  }

  if (uStarAmt > 0.001) {
    float cover;
    vec3 s = starSurface(uv, cover);
    col = mix(col, vec3(0.0), cover * 0.96) + s;
  }

  // Вспышка и белое поле. Свет заливает кадр целиком — это единственный
  // момент, когда на экране не остаётся ничего.
  col += CORE * uFlash;
  col = mix(col, CORE * 1.5, uWhite);

  col += BG;
  fragColor = vec4(col, 1.0);
}
